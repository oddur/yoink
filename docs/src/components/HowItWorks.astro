---
// Two animated figures for the home page: how yoink reaches a host (SSH,
// then the Docker daemon, nothing installed), and how HTTPS traffic is
// handled (bundled Caddy, a certificate from Let's Encrypt or Cloudflare).
// Each figure is a short sequence of steps. It plays while it is on
// screen, and every step is also a button.
const ssh = [
  'You run <code>yoink up</code> on your laptop or in CI. yoink is one binary, and it runs only there.',
  'yoink opens an SSH connection to each host with your key. The hosts need sshd and Docker, and nothing else.',
  'Through that connection it tells the Docker daemon on the host what to do: pull the image, create the containers, start them.',
  'yoink disconnects. The containers keep running, and no yoink process stays on the host.',
];
const https = [
  { both: 'Point the DNS record at the host. Then set <code>domain:</code> on the service. That one field turns the proxy on.' },
  { both: 'yoink starts Caddy on the host and sends it the routes. You do not write a Caddy config.' },
  {
    le: 'Caddy gets a certificate for the domain from Let\'s Encrypt and renews it. The only setup is an email address in <code>proxy.email</code>.',
    cf: 'Caddy serves a Cloudflare origin certificate that you seal in the repo. It can also refuse every request that does not come from Cloudflare.',
  },
  {
    le: 'Requests arrive on port 443. Caddy sends them to the replicas that pass their healthcheck.',
    cf: 'Requests arrive on port 443 through Cloudflare. Caddy sends them to the replicas that pass their healthcheck.',
  },
];
const ship = [
  '<code>yoink up --build</code> builds the image with Docker on your laptop or on a CI runner.',
  'yoink starts a short-lived registry on the host and reaches it through the SSH connection.',
  'It sends only the layers that the host does not have. A redeploy ships the changed layers and nothing else.',
  'The image is now in Docker on the host, and the short-lived registry is removed. You need no registry account and no <code>docker push</code>.',
];
const ci = [
  'Push to your deploy branch. The workflow starts on a GitHub runner.',
  'The workflow installs yoink with one line and runs <code>yoink up</code>: the same command that you run by hand.',
  'One repository secret, <code>YOINK_AGE_KEY</code>, opens the sealed secrets in your repo. The SSH key for your hosts can be one of them.',
  'The runner deploys over SSH, as your laptop does. On a pull request, <code>yoink up --dry-run</code> can post the plan as a comment.',
];
const workflow = `# .github/workflows/deploy.yml
name: Deploy
on:
  push:
    branches: [live]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install yoink
        run: |
          curl -LsSf https://github.com/oddur/yoink/releases/latest/download/yoink-installer.sh | sh
          echo "$HOME/.cargo/bin" >> $GITHUB_PATH

      - name: Deploy
        run: yoink up --tag api=\${{ github.sha }}
        env:
          YOINK_AGE_KEY: \${{ secrets.YOINK_AGE_KEY }}
`;
---
<section class="panel how" aria-labelledby="how-h">
  <div class="wrap">
    <div class="panel__head">
      <h2 class="pack-type" id="how-h">How it works</h2>
      <p class="lead">yoink has no server of its own. It logs in to your hosts over SSH and tells Docker what to run. A bundled Caddy handles the HTTPS, images need no registry, and the same command runs from GitHub Actions.</p>
    </div>

    <div class="how__tabs" role="tablist" aria-label="How it works">
      <button type="button" role="tab" id="tab-ssh" aria-controls="panel-ssh" aria-selected="true">SSH</button>
      <button type="button" role="tab" id="tab-https" aria-controls="panel-https" aria-selected="false" tabindex="-1">HTTPS</button>
      <button type="button" role="tab" id="tab-ship" aria-controls="panel-ship" aria-selected="false" tabindex="-1">No registry</button>
      <button type="button" role="tab" id="tab-ci" aria-controls="panel-ci" aria-selected="false" tabindex="-1">GitHub Actions</button>
    </div>

    <div class="how__frame" data-figs>
      <figure class="fig" data-fig id="panel-ssh" role="tabpanel" aria-labelledby="tab-ssh">
        <figcaption>
          <h3 class="pack-type" id="fig-ssh">It configures Docker over SSH</h3>
          <button class="fig__play spec-type" type="button" data-play>Play</button>
        </figcaption>
        <svg class="fig__art" viewBox="0 0 400 330" role="img" aria-label="A laptop connects over SSH to two hosts, box-1 and box-2. Containers appear on each host, then the connection closes.">
          <!-- laptop -->
          <g class="n" data-lit="0">
            <rect x="16" y="110" width="120" height="80" class="s-paper" />
            <path d="M4 198h144" class="s-line" />
            <text x="27" y="156" class="t-mono">$ yoink up</text>
          </g>
          <text x="76" y="224" class="t-label" text-anchor="middle">Laptop or CI</text>

          <!-- ssh connections -->
          <g data-from="1" data-until="3">
            <path d="M136 145 250 85" class="s-wire" />
            <path d="M136 155 250 245" class="s-wire" />
            <text x="160" y="155" class="t-label t-blue">SSH</text>
          </g>
          <g data-only="2">
            <rect x="132" y="141" width="8" height="8" class="pkt" style="--dx:114;--dy:-60" />
            <rect x="132" y="141" width="8" height="8" class="pkt" style="--dx:114;--dy:-60;--delay:0.55s" />
            <rect x="132" y="151" width="8" height="8" class="pkt" style="--dx:114;--dy:90;--delay:0.25s" />
            <rect x="132" y="151" width="8" height="8" class="pkt" style="--dx:114;--dy:90;--delay:0.8s" />
          </g>

          <!-- hosts -->
          {[30, 190].map((y, h) => (
            <g>
              <rect x="250" y={y} width="134" height="110" class="s-paper n" data-lit="1" />
              <text x="262" y={y + 22} class="t-label">box-{h + 1}</text>
              <text x="262" y={y + 39} class="t-mono t-soft">sshd, docker</text>
              {[0, 1, 2].map((i) => (
                <rect x={262 + i * 38} y={y + 56} width="32" height="36" class="s-box" data-from="2" style={`--delay:${0.5 + i * 0.35 + h * 0.15}s`} />
              ))}
            </g>
          ))}
        </svg>
        <ol class="fig__steps">
          {ssh.map((text, i) => (
            <li><button type="button" data-go={i}><span set:html={text} /></button></li>
          ))}
        </ol>
      </figure>

      <figure class="fig" data-fig data-mode="le" id="panel-https" role="tabpanel" aria-labelledby="tab-https">
        <figcaption>
          <h3 class="pack-type" id="fig-https">HTTPS from one field</h3>
          <button class="fig__play spec-type" type="button" data-play>Play</button>
        </figcaption>
        <div class="fig__modes" role="group" aria-label="Where the certificate comes from">
          <button type="button" class="spec-type" data-set-mode="le" aria-pressed="true">Let's Encrypt</button>
          <button type="button" class="spec-type" data-set-mode="cf" aria-pressed="false">Cloudflare</button>
        </div>
        <svg class="fig__art" viewBox="0 0 400 330" role="img" aria-label="A visitor's request reaches Caddy on the host on port 443. Caddy holds the certificate and passes the request to one of three replicas of the service.">
          <!-- the one field -->
          <g class="n" data-lit="0">
            <rect x="12" y="12" width="212" height="30" class="s-ink" />
            <text x="22" y="32" class="t-mono t-yellow">domain: api.example.com</text>
          </g>

          <!-- visitor -->
          <rect x="12" y="150" width="70" height="50" class="s-paper n" data-lit="3" />
          <path d="M12 164h70" class="s-line" />
          <text x="47" y="220" class="t-label" text-anchor="middle">Visitor</text>
          <path d="M82 175H204" class="s-wire" data-from="3" />

          <!-- cloudflare, only in that mode -->
          <g data-mode="cf" data-from="2">
            <rect x="98" y="158" width="90" height="34" class="s-yellow" />
            <text x="143" y="180" class="t-small" text-anchor="middle">Cloudflare</text>
          </g>

          <!-- host -->
          <rect x="190" y="70" width="198" height="236" class="s-paper" />
          <text x="202" y="92" class="t-label">box-1</text>

          <!-- caddy -->
          <g data-from="1">
            <rect x="204" y="140" width="78" height="70" class="s-yellow n" data-lit="1" />
            <text x="243" y="172" class="t-label" text-anchor="middle">Caddy</text>
            <text x="243" y="191" class="t-mono" text-anchor="middle">:443</text>
            <path d="M282 175 322 127M282 175h40M282 175l40 58" class="s-line" />
          </g>
          <!-- padlock: the certificate is in place -->
          <g data-from="3" class="lock">
            <rect x="262" y="128" width="26" height="22" class="s-ink" />
            <path d="M268 128v-6a7 7 0 0 1 14 0v6" class="s-line" />
          </g>

          <!-- replicas -->
          {[112, 165, 218].map((y, i) => (
            <g>
              <rect x="322" y={y} width="56" height="30" class="s-ink" />
              <text x="350" y={y + 20} class="t-mono t-yellow" text-anchor="middle">api-{i}</text>
            </g>
          ))}

          <!-- config push: yoink to Caddy -->
          <rect x="106" y="38" width="8" height="8" class="pkt" data-only="1" style="--dx:133;--dy:100" />
          <rect x="106" y="38" width="8" height="8" class="pkt" data-only="1" style="--dx:133;--dy:100;--delay:0.6s" />

          <!-- certificate source -->
          <g data-from="2">
            <rect x="236" y="12" width="152" height="30" class="s-paper n" data-lit="2" />
            <text x="312" y="32" class="t-small" text-anchor="middle" data-mode="le">Let's Encrypt</text>
            <text x="312" y="32" class="t-small" text-anchor="middle" data-mode="cf">Sealed origin cert</text>
            <path d="M300 42 226 140" class="s-wire" />
          </g>
          <rect x="296" y="38" width="10" height="8" class="pkt pkt--cert" data-only="2" style="--dx:-74;--dy:96" />

          <!-- requests -->
          {[-48, 5, 58].map((dy, i) => (
            <rect x="78" y="171" width="8" height="8" class="pkt pkt--req" data-only="3" style={`--mx:204;--dx:244;--dy:${dy};--delay:${i * 0.45}s`} />
          ))}
        </svg>
        <ol class="fig__steps">
          {https.map((s, i) => (
            <li>
              <button type="button" data-go={i}>
                {s.both && <span set:html={s.both} />}
                {s.le && <span data-mode="le" set:html={s.le} />}
                {s.cf && <span data-mode="cf" set:html={s.cf} />}
              </button>
            </li>
          ))}
        </ol>
      </figure>

      <figure class="fig" data-fig id="panel-ship" role="tabpanel" aria-labelledby="tab-ship">
        <figcaption>
          <h3 class="pack-type" id="fig-ship">No registry needed</h3>
          <button class="fig__play spec-type" type="button" data-play>Play</button>
        </figcaption>
        <svg class="fig__art" viewBox="0 0 400 330" role="img" aria-label="A laptop builds an image of four layers. The host already has three of them. A short-lived registry appears on the host, one layer travels over SSH, and the registry disappears.">
          <!-- laptop with the built image -->
          <g class="n" data-lit="0">
            <rect x="16" y="70" width="128" height="150" class="s-paper" />
            <path d="M4 228h152" class="s-line" />
            <text x="27" y="96" class="t-mono">$ yoink up</text>
            <text x="27" y="113" class="t-mono">  --build</text>
          </g>
          {[0, 1, 2].map((i) => <rect x="28" y={190 - i * 18} width="104" height="14" class="s-box-flat" />)}
          <rect x="28" y="136" width="104" height="14" class="s-new" />
          <text x="80" y="250" class="t-label" text-anchor="middle">Laptop or CI</text>

          <!-- host -->
          <rect x="250" y="40" width="134" height="250" class="s-paper" />
          <text x="262" y="62" class="t-label">box-1</text>

          <!-- the short-lived registry -->
          <g data-from="1" data-until="3">
            <rect x="262" y="76" width="110" height="34" class="s-dashed n" data-lit="1" />
            <text x="317" y="98" class="t-small" text-anchor="middle">registry</text>
            <path d="M144 150 262 93" class="s-wire" />
            <text x="176" y="112" class="t-label t-blue">SSH</text>
          </g>
          <rect x="140" y="146" width="12" height="8" class="pkt pkt--new" data-only="2" style="--dx:118;--dy:-57;--dur:1.5s" />

          <!-- the container, once the image is there -->
          <g data-from="3">
            <rect x="262" y="124" width="110" height="38" class="s-ink n" data-lit="3" />
            <text x="317" y="148" class="t-mono t-yellow" text-anchor="middle">api running</text>
          </g>

          <!-- layers on the host: three were there already -->
          {[0, 1, 2].map((i) => <rect x="262" y={258 - i * 18} width="110" height="14" class="s-box-flat" />)}
          <rect x="262" y="204" width="110" height="14" class="s-new" data-from="2" style="--delay:1.1s" />
          <text x="317" y="194" class="t-mono t-soft" text-anchor="middle">image layers</text>
        </svg>
        <ol class="fig__steps">
          {ship.map((text, i) => (
            <li><button type="button" data-go={i}><span set:html={text} /></button></li>
          ))}
        </ol>
      </figure>

      <figure class="fig" data-fig id="panel-ci" role="tabpanel" aria-labelledby="tab-ci">
        <figcaption>
          <h3 class="pack-type" id="fig-ci">Drops into GitHub Actions</h3>
          <button class="fig__play spec-type" type="button" data-play>Play</button>
        </figcaption>
        <svg class="fig__art" viewBox="0 0 400 330" role="img" aria-label="A git push starts a GitHub runner. The runner checks out the repo, installs yoink and runs yoink up, which deploys to the host box-1 over SSH.">
          <g class="n" data-lit="0">
            <rect x="12" y="16" width="100" height="30" class="s-ink" />
            <text x="62" y="36" class="t-mono t-yellow" text-anchor="middle">git push</text>
          </g>
          <path d="M62 46V82" class="s-wire" />
          <rect x="58" y="44" width="8" height="8" class="pkt" data-only="0" style="--dx:0;--dy:36;--dur:0.9s" />

          <!-- runner -->
          <rect x="12" y="82" width="176" height="232" class="s-paper" />
          <text x="24" y="104" class="t-label">GitHub runner</text>
          {['checkout', 'install yoink', 'yoink up'].map((label, i) => (
            <g>
              <rect x="24" y={118 + i * 40} width="152" height="30" class="s-chip n" data-lit="1" style={`--delay:${i * 0.35}s`} />
              <text x="34" y={138 + i * 40} class="t-mono t-yellow">{label}</text>
            </g>
          ))}
          <g data-from="2">
            <rect x="24" y="268" width="152" height="30" class="s-yellow n" data-lit="2" />
            <text x="100" y="288" class="t-mono" text-anchor="middle">YOINK_AGE_KEY</text>
            <path d="M100 268V228" class="s-line" />
          </g>

          <!-- host -->
          <rect x="262" y="82" width="122" height="232" class="s-paper n" data-lit="3" />
          <text x="274" y="104" class="t-label">box-1</text>
          {[0, 1, 2].map((i) => (
            <rect x={274 + i * 36} y="194" width="28" height="38" class="s-box" data-from="3" style={`--delay:${0.5 + i * 0.3}s`} />
          ))}
          <g data-from="3">
            <path d="M176 213H262" class="s-wire" />
            <text x="204" y="204" class="t-label t-blue">SSH</text>
          </g>
          <rect x="172" y="209" width="8" height="8" class="pkt" data-only="3" style="--dx:90;--dy:0;--dur:1s" />
          <rect x="172" y="209" width="8" height="8" class="pkt" data-only="3" style="--dx:90;--dy:0;--dur:1s;--delay:0.5s" />
        </svg>
        <ol class="fig__steps">
          {ci.map((text, i) => (
            <li><button type="button" data-go={i}><span set:html={text} /></button></li>
          ))}
        </ol>
        <details class="flow">
          <summary class="spec-type">Show the whole workflow</summary>
          <div class="receipt receipt--flow">
            <p class="receipt__head"><span class="spec-type">.github/workflows/deploy.yml</span><button type="button" class="spec-type" data-copy={workflow} data-done="Yoinked">Copy workflow</button></p>
            <pre><code>{workflow}</code></pre>
          </div>
        </details>
      </figure>
    </div>

    <p class="how__more">
      <a href="/docs/explanation/architecture">How a deploy works, in detail</a>
      <a href="/docs/explanation/proxy">The reverse proxy</a>
      <a href="/docs/how-to/cloudflare-origin-certs">Cloudflare origin certificates</a>
      <a href="/docs/explanation/image-shipping">How images ship without a registry</a>
      <a href="/docs/how-to/age-in-github-actions">Deploy from GitHub Actions</a>
    </p>
  </div>
</section>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const HOLD = 3200; // time on each step while a figure plays

  const frame = document.querySelector<HTMLElement>('[data-figs]');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.how__tabs [role="tab"]')];
  if (frame && tabs.length) {
    let active = 0;
    let visible = false;
    let timer: number | undefined;

    const figs = [...frame.querySelectorAll<HTMLElement>('[data-fig]')].map((el) => {
      const steps = [...el.querySelectorAll<HTMLButtonElement>('[data-go]')];
      const parts = [...el.querySelectorAll<SVGElement>('[data-from], [data-only], [data-lit]')];
      const fig = {
        el,
        play: el.querySelector<HTMLButtonElement>('[data-play]')!,
        last: steps.length - 1,
        step: 0,
        playing: false,
        played: false, // each figure plays by itself once
        show(n: number) {
          fig.step = n;
          el.dataset.step = String(n);
          for (const part of parts) {
            const d = part.dataset;
            const on =
              (d.from === undefined || (n >= +d.from && (d.until === undefined || n < +d.until))) &&
              (d.only === undefined || n === +d.only);
            part.classList.toggle('is-on', on);
            if (d.lit !== undefined) part.classList.toggle('is-lit', n === +d.lit);
          }
          steps.forEach((b, i) => {
            if (i === n) b.setAttribute('aria-current', 'step');
            else b.removeAttribute('aria-current');
          });
        },
      };
      steps.forEach((b, i) =>
        b.addEventListener('click', () => {
          fig.playing = false; // the reader has taken over
          fig.show(i);
          sync();
        }),
      );
      fig.play.addEventListener('click', () => {
        if (fig.playing) fig.playing = false;
        else {
          if (fig.step === fig.last) fig.show(0);
          fig.playing = true;
        }
        sync();
      });
      el.querySelectorAll<HTMLButtonElement>('[data-set-mode]').forEach((b) =>
        b.addEventListener('click', () => {
          el.dataset.mode = b.dataset.setMode;
          el.querySelectorAll('[data-set-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        }),
      );
      // With reduced motion a figure opens complete; otherwise at its first step.
      fig.show(still ? fig.last : 0);
      return fig;
    });

    // One clock for the one figure on screen.
    function sync() {
      clearTimeout(timer);
      const fig = figs[active];
      if (visible && !fig.played && !still) {
        fig.played = true;
        fig.show(0);
        fig.playing = true;
      }
      figs.forEach((f, i) => f.el.classList.toggle('is-live', visible && i === active));
      fig.play.textContent = fig.playing ? 'Pause' : fig.step === fig.last ? 'Replay' : 'Play';
      if (fig.playing && visible) {
        timer = window.setTimeout(() => {
          fig.show(fig.step + 1);
          if (fig.step === fig.last) fig.playing = false; // stop on the finished picture
          sync();
        }, HOLD);
      }
    }

    function select(i: number, focus = false) {
      figs[active].playing = false;
      active = i;
      tabs.forEach((t, n) => {
        t.setAttribute('aria-selected', String(n === i));
        t.tabIndex = n === i ? 0 : -1;
      });
      figs.forEach((f, n) => (f.el.hidden = n !== i));
      if (focus) tabs[i].focus();
      sync();
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
        if (e.key === 'Home') select(0, true);
        if (e.key === 'End') select(tabs.length - 1, true);
      });
    });
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        sync();
      },
      { threshold: 0.4 },
    ).observe(frame);

    frame.closest('.how')!.classList.add('is-ready');
    figs.forEach((f) => f.el.classList.add('is-ready'));
    select(0);
  }
</script>
