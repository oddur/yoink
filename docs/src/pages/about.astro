---
import { getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ProseScripts from '@/components/ProseScripts.astro';
import { mdxComponents } from '@/components/mdx';
import '@/styles/leaflet.css';
const entry = await getEntry('about', 'about');
if (!entry) throw new Error('content/about.mdx is missing');
const { Content } = await render(entry);
---
<Base title="About" description="Why I built yoink." current="about">
  <main class="leaflet" id="main" data-pagefind-body>
    <article class="sheet">
      <div class="prose"><Content components={mdxComponents} /></div>
    </article>
  </main>
  <ProseScripts />
</Base>
