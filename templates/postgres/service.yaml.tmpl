services:
  - name: {{ service_name }}
    image: postgres
    tag: "{{ version }}-alpine"
    env:
      POSTGRES_DB: {{ database }}
      POSTGRES_USER: {{ user }}
    env_from_secrets:
      POSTGRES_PASSWORD: {{ service_name | upper }}_PASSWORD
    run:
      volumes:
        - pgdata-{{ service_name }}:/var/lib/postgresql/data
      options:
        memory: {{ memory }}
        # The postgres entrypoint runs initdb as root, chowns the data
        # volume, then drops privileges to the postgres user via gosu.
        # Override yoink's `user: nobody` default so initdb can do its
        # thing; add back the caps it needs (yoink's default drops
        # ALL); leave the rootfs writable for /var/run/postgresql and
        # initdb's tempfiles.
        user: "0:0"
        cap_add: [CHOWN, DAC_OVERRIDE, FOWNER, SETGID, SETUID]
        read_only: false
