services:
  - name: {{ service_name }}
    image: postgres
    tag: "18-alpine"
    env:
      POSTGRES_DB: {{ database }}
      POSTGRES_USER: {{ user }}
    env_from_secrets:
      POSTGRES_PASSWORD: {{ service_name | upper }}_PASSWORD
      {%- if wal_archiving == "true" %}
      AWS_ACCESS_KEY_ID: S3_ACCESS_KEY_ID
      AWS_SECRET_ACCESS_KEY: S3_SECRET_ACCESS_KEY
      {%- endif %}
    run:
      {%- if wal_archiving == "true" %}
      # WAL archiving wrapper. Installs aws-cli on first start, then
      # hands off to the stock postgres entrypoint with archive_mode
      # flags. The archive_command runs as the postgres user, so the
      # aws binary needs to be on $PATH for that user too — apk's
      # default install to /usr/bin satisfies that.
      entrypoint: ["/bin/sh", "-c"]
      cmd:
        - |
          set -e
          if ! command -v aws >/dev/null; then
            apk add --no-cache aws-cli >/dev/null
          fi
          exec docker-entrypoint.sh postgres \
            -c archive_mode=on \
            -c wal_level=replica \
            -c wal_compression=zstd \
            -c archive_timeout=300 \
            -c "archive_command=gzip -c %p | aws s3 cp{% if wal_endpoint %} --endpoint-url={{ wal_endpoint }}{% endif %} - {{ wal_repository }}/%f.gz"
      {%- endif %}
      volumes:
        # postgres 18+ stores data at /var/lib/postgresql/<major>/docker
        # (per pg_ctlcluster's layout); mount the parent dir, not /data.
        - pgdata-{{ service_name }}:/var/lib/postgresql
      options:
        memory: {{ memory }}
        # Stable DNS name for in-network clients. Without this, yoink
        # only registers `{{ service_name }}-<spec_hash>` as the alias,
        # so `host: {{ service_name }}` in the connecting service's
        # config wouldn't resolve.
        network_aliases: [{{ service_name }}]
        # The postgres entrypoint runs initdb as root, chowns the data
        # volume, then drops privileges to the postgres user via gosu.
        # Override yoink's `user: nobody` default so initdb can do its
        # thing; add back the caps it needs (yoink's default drops
        # ALL); leave the rootfs writable for /var/run/postgresql and
        # initdb's tempfiles.
        user: "0:0"
        cap_add: [CHOWN, DAC_OVERRIDE, FOWNER, SETGID, SETUID]
        read_only: false
